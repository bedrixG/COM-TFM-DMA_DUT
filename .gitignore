###############################################
# Gitignore file for a complete FPGA Project
# I M P O R T A N T
# There are gitignore files for each software
# You can find this files in the main folder
# of each software. If modifying this file
# does not allow you to track a file
# check the gitignore file for the specific
# software.
##############################################

# Emacs backup files
###############################################
*.bak
*~
*#

# Unwanted stuff
###############################################
*.qar   # Archived projects
*.pdf   # No PDFs are allowed in the GIT repo
*.rar   
*.zip
*.csv  
*.log

# Files generated by compilation from several programs
###############################################
PROJECTS/**/db/*

# Ignore all subdirectories under PROJECTS/Vivado
/PROJECTS/Vivado/*/
/simple_dut/hw/*/
/simple_dut/sw/*/

# But do not ignore files directly in PROJECTS/Vivado
!/PROJECTS/Vivado/*


# Unwanted files
###############################################
*.o
*.exe
*.d
*.axf
*.mk 
*.hiof
*.bsf
*.rpt
*.regmap
*.svd
*.cmp
*.mif
*.xpr